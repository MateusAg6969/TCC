# MongoDB
MONGODB_URI=mongodb://localhost:27017/if-rede

# Ambiente
NODE_ENV=development

# Servidor
PORT=3000
HOST=localhost

# Autenticação JWT
JWT_SECRET=sua_chave_secreta_super_segura_aqui_123456
JWT_REFRESH_SECRET=sua_chave_refresh_super_segura_aqui_654321
JWT_EXPIRATION=24

# Bcrypt
BCRYPT_ROUNDS=10

# Email (Opcional)
EMAIL_SERVICE=gmail
EMAIL_USER=seu-email@gmail.com
EMAIL_PASSWORD=sua_senha_app_aqui

# AWS S3 (Opcional)
AWS_ACCESS_KEY_ID=sua_chave_aqui
AWS_SECRET_ACCESS_KEY=seu_secret_aqui
AWS_REGION=us-east-1
