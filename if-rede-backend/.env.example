/**
 * ============================================================================
 * ARQUIVO .env EXEMPLO
 * ============================================================================
 * Copie este arquivo para .env e preencha com seus valores reais.
 * NUNCA commite o arquivo .env com dados sensíveis no Git!
 */

// ============================================================================
// MONGODB
// ============================================================================

// URI de conexão com MongoDB
// Local: mongodb://localhost:27017/if-rede
// Atlas (Cloud): mongodb+srv://user:password@cluster.mongodb.net/if-rede
MONGODB_URI=mongodb://localhost:27017/if-rede

// ============================================================================
// AMBIENTE
// ============================================================================

// development | production | test
NODE_ENV=development

// ============================================================================
// SERVIDOR
// ============================================================================

// Porta onde a aplicação rodará
PORT=3000

// Host
HOST=localhost

// ============================================================================
// AUTENTICAÇÃO
// ============================================================================

// Secret para JWT (gere com: openssl rand -base64 32)
JWT_SECRET=sua_chave_secreta_super_segura_aqui

// Secret para refresh token JWT
JWT_REFRESH_SECRET=sua_chave_refresh_super_segura_aqui

// Tempo de expiração do token (em horas)
JWT_EXPIRATION=24

// ============================================================================
// BCRYPT (Hashing de senhas)
// ============================================================================

// Número de rounds para bcrypt (10-12 é recomendado)
BCRYPT_ROUNDS=10

// ============================================================================
// EMAIL (Opcional para notificações)
// ============================================================================

// Serviço de email
EMAIL_SERVICE=gmail

// Email para enviar notificações
EMAIL_USER=seu-email@gmail.com

// Senha de app (não a senha regular do Gmail)
EMAIL_PASSWORD=sua_senha_app_aqui

// ============================================================================
// AWS S3 (Para armazenar áudio/imagem)
// ============================================================================

// Key de acesso AWS
AWS_ACCESS_KEY_ID=sua_chave_aqui

// Secret de acesso AWS
AWS_SECRET_ACCESS_KEY=seu_secret_aqui

// Região S3
AWS_REGION=us-east-1

// Nome do bucket S3
AWS_S3_BUCKET=if-rede-uploads

// ============================================================================
// CLOUDINARY (Alternativa ao S3)
// ============================================================================

// Cloud name no Cloudinary
CLOUDINARY_CLOUD_NAME=seu_cloud_name

// Chave API Cloudinary
CLOUDINARY_API_KEY=sua_chave_api

// Secret Cloudinary
CLOUDINARY_API_SECRET=seu_secret

// ============================================================================
// MODERAÇÃO
// ============================================================================

// Máximo de postagens por semana para egressos
EGRESSO_MAX_POSTS_SEMANA=2

// Dias de suspensão padrão
SUSPENSAO_DIAS_PADRAO=7

// Limite de denúncias para bloquear automaticamente
DENUNCIA_LIMITE_BLOQUEIO=5

// ============================================================================
// TTL (Rascunhos)
// ============================================================================

// Dias para expiração de rascunhos
RASCUNHO_DIAS_EXPIRACAO=14

// ============================================================================
// LOGS
// ============================================================================

// Nível de log: error | warn | info | debug | trace
LOG_LEVEL=info

// Arquivo de log
LOG_FILE=./logs/app.log

// ============================================================================
// SEGURANÇA
// ============================================================================

// Rate limit por IP (requisições por minuto)
RATE_LIMIT_POR_MINUTO=100

// Ativar CORS
CORS_ENABLED=true

// Origins permitidos (separados por vírgula).
// Em produção, defina explicitamente os domínios do frontend.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

// ============================================================================
// DESENVOLVIMENTO
// ============================================================================

// Ativar modo debug
DEBUG=false

// Seed do banco automaticamente
AUTO_SEED=false

// Limpar banco ao iniciar (CUIDADO!)
CLEAR_DB_ON_START=false
