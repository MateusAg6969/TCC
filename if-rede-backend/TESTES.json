      "corpo_requisicao": {
        "nome": "João Silva",
        "email": "joao@test.ifrede.com",
        "matricula": "2024001",
        "senha": "Senha@123456",
        "status_vinculo": "estudante"
      },
      "exemplo_curl": "curl -X POST http://localhost:3000/auth/register -H 'Content-Type: application/json' -d '{...}'",
