      "corpo_requisicao": null,
      "exemplo_curl": "curl http://localhost:3000/health",
      "resposta_esperada": {
        "status": 200,
        "corpo": {
          "data": {
            "service": "if-rede-backend",
            "now": "2026-05-19T..."
          },
          "message": "Serviço disponível."
        }
      },
      "o_que_valida": "Servidor está rodando corretamente"
    },

